# --- Configuration réelle : ne JAMAIS versionner ---
config.ini
*/config.ini
**/config.ini

# --- Exécutables et artefacts de compilation ---
*.exe
build/
dist/
*.spec.bak
__pycache__/
*.py[cod]
*.egg-info/
.eggs/

# --- Journaux ---
*.log
logs/

# --- Sauvegardes / dumps de base contenant des données ---
# (le SCHÉMA creation_base_donnees.sql, lui, est versionné)
*dump*.sql
*backup*.sql
*sauvegarde*.sql
*_data.sql
*.dump
*.backup
sauvegardes/
backups/

# --- Diagnostics horodatés (sorties locales, non pertinentes pour le dépôt) ---
QuincaillerieFranck_Test/diagnostic_*/

# --- Node / outils de vérification ---
node_modules/
package-lock.json
.playwright-mcp/

# --- Serveur PostgreSQL portable de développement (binaires + données) ---
# Installé par db/outils/demarrer_pg.ps1 au premier lancement. Ne se
# télécharge et ne se recrée qu'en local : ~1 Go, aucune donnée à versionner.
_pgdev/

# --- Fichiers téléversés par l'application (cycle 28) ---
# Logo de la boutique cliente (server/app/routes/configuration.py) : jamais
# versionné (donnée réelle propre à chaque installation), inclus dans la
# sauvegarde/restauration (db/outils/sauvegarder.ps1/restaurer.ps1) à la
# place.
server/donnees/

# --- Worktrees Git du travail en parallèle (voir RAPPORT AVANCEMENT/TRAVAIL_PARALLELE.md) ---
# Chaque worktree est un checkout complet d'une branche de piste ; le
# contenu suivi vit dans le dépôt principal via ces branches, jamais ici.
_worktrees/

# --- Environnements virtuels ---
.venv/
venv/
env/

# --- Divers OS / éditeurs ---
Thumbs.db
Desktop.ini
.DS_Store
*.swp
.idea/
.vscode/
